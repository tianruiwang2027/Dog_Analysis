# experiments/coral_reference_results/, both explicitly excepted below)
*.pkl
!weights/*.pkl

# python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# OS / editor cruft
.DS_Store
.ipynb_checkpoints/
*.swp
